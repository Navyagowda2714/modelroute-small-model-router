# Large-model provider for fallbacks: anthropic | openai | ollama | offline
LLM_PROVIDER=offline
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Router
MODELROUTE_THRESHOLD=0.8          # used if artifacts/threshold.json (from `make eval`) is absent
MODELROUTE_USE_COMPLEXITY=true
MODELROUTE_PRICES_PATH=configs/prices.yaml
MODELROUTE_ARTIFACTS_DIR=artifacts
MODELROUTE_DATA_DIR=data/generated
